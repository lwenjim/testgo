GO_BUILD_FLAGS_DEBUG   := -v -x -gcflags "-N -l"
GO_BUILD_FLAGS_RELEASE := -v -x -trimpath -ldflags "-s -w"

deploy_window: convert_master update_model deploy_window_do print_version
update_model: generate_shard_sql create_database_shard_from_sql 

xml_to_csv_build:
	@GOOS=windows GOARCH=amd64 CGO_ENABLED=0 go build -o ~/Downloads/TableCompiler.exe $(GO_BUILD_FLAGS_DEBUG) cmd/export_masterdata/main.go

xml_to_csv_build_run: xml_to_csv_build
