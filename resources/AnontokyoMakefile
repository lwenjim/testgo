	@cd ~/Workdata/sirius-client-dev/bili-tools/at-tools/ && ./TableCompiler ~/Workdata/anontokyo_server/master_data_repos
	@cd ~/Workdata/anontokyo_server

backfile:
	@cp global/signal.go ~/sirius-client-dev
	@cp global/signal_unix.go ~/sirius-client-dev
	@cp global/signal_windows.go ~/sirius-client-dev

csv_to_json_build:
	@GOOS=windows GOARCH=amd64 CGO_ENABLED=0 go build -o ~/Downloads/CsvToJson.exe $(GO_BUILD_FLAGS_DEBUG) cmd/csv_json/main.go

deploy_config:
	@$(MAKE) -C $(SIRIUS_DIR) deploy_config
# 	$(call deploy_to_dev,AnonTokyoConfig.zip)

version:
	@cat atmastercbor/Version;echo
	@$(MAKE) -C $(SIRIUS_DIR) version

switch_to_dev:
	@gsed -i 's/localhost/10.27.6.27/' "./config/roles/local/config.yaml"
	@$(MAKE) -C $(SIRIUS_DIR) switch_to_dev

switch_to_local:
	@gsed -i 's/10.27.6.27/localhost/' "./config/roles/local/config.yaml"
	@$(MAKE) -C $(SIRIUS_DIR) switch_to_local

switch_to_dev2:
	@gsed -i 's/localhost/10.27.7.168/' "./config/roles/local/config.yaml"
	@$(MAKE) -C $(SIRIUS_DIR) switch_to_dev2

switch_to_local2:
	@gsed -i 's/10.27.7.168/localhost/' "./config/roles/local/config.yaml"
	@$(MAKE) -C $(SIRIUS_DIR) switch_to_local2

# 代码规范扫描
lint:
	@echo Lint
	@golangci-lint run -v ./...

# 执行单元测试 并 生成覆盖率文件
test:clean
	@echo Test
	@go list -f '{{if gt (len .TestGoFiles) 0}}"go test -tags test -covermode count -coverprofile {{.Name}}.coverprofile -coverpkg ./... {{.ImportPath}}"{{end}}' ./... | xargs -P $(shell nproc 2>/dev/null || sysctl -n hw.ncpu) -I {} sh -c {}
	@gocovmerge `ls *.coverprofile` | grep -v ".pb.go" | grep -v ".gen.go" > coverage.out
	@go tool cover -func coverage.out | grep total

# 查看单元测试覆盖率
cover: test
	@echo cover
	@go tool cover -html coverage.out

# mock 外部调用
mock:
	@echo mock
	@rm -rf mocks/*.go
	@mockery --all --dir=./gen/app/bilibili/anontokyo

# ========== Git Hooks ==========

# 嵌入 git 客户端的脚本, 提交前审核, commit text 审核
pre_commit:
	@echo pre_commit
	@cp shell/{commit-msg,pre-commit} .git/hooks

# ========== 配表 / Proto / 模型 ==========

# 配表变更
convert_master:
	@echo "Local version: $(shell cat atmastercbor/Version)"
	@cd atmastercbor&& rm -rf ./*
	@go run cmd/convert_master/main.go
	$(call print_version_info)
	@rm -rf ~/Downloads/AnonTokyoConfig.zip >/dev/null
	@zip -q -r ~/Downloads/AnonTokyoConfig.zip atmastercbor

# 配表反向还原：cbor -> json（convert_master 的逆操作）
build_convert_master_reverse:
	@GOOS=linux GOARCH=amd64 CGO_ENABLED=0   go build -o ~/Downloads/convert_master_reverse cmd/convert_master_reverse/main.go

build_tocbor:
	@GOOS=linux GOARCH=amd64 CGO_ENABLED=0  go build -o ~/Downloads/toatmastercbor cmd/convert_master/main.go

# proto 变更
proto:
	@buf generate
	@protofmt -w pb/app/bilibili/anontokyo/*.proto
	@protoc-go-inject-tag -input="./gen/app/bilibili/anontokyo/*.pb.go"
	@rm -rf ~/Downloads/AnontokyoDocs.zip; zip -r ~/Downloads/AnontokyoDocs.zip docs
	$(call deploy_to_dev,AnontokyoDocs.zip)
	@cp -rf ./docs ~/Downloads/docs

stress_test:
	@go run cmd/stress_test/main.go

fmtgo:
	@git status -s|awk '{print $2}'|xargs -I {} echo {}|grep -E ".go$"|xargs -I {} goimports -w {}

# 模型变更
generate_shard_sql:
	@go run cmd/gorm_gen/create_table/main.go

create_database_shard_from_sql:
	$(call rebuild_shard_db,$(MASTER_HOST))

generate_gorm_model:
	@cd cmd/gorm_gen/gen_code && go run main.go

json_key_convert:
	@cd cmd/json_key_convert/ && go run main.go

# ========== 构建 / 运行 ==========

build:
	@go build .

run:
	@go run main.go

deploy_release:
	@GOOS=linux GOARCH=amd64 CGO_ENABLED=0 go build -o /tmp $(GO_BUILD_FLAGS_RELEASE) .

# ========== 部署 ==========

deploy_sirius:
#	@$(MAKE) -C $(SIRIUS_DIR) mysqldump
	@$(MAKE) -C $(SIRIUS_DIR) deploy_window

sync_table:
	$(call rebuild_shard_db,$(DEVHOST))


deploy_window_do: deploy_table deploy_program

deploy_table:
# 	$(call rebuild_shard_db,$(DEVHOST))
# 	构建配置文件
	@rm -rf ~/Downloads/AnonTokyoConfig.zip >/dev/null
	@zip -q -r ~/Downloads/AnonTokyoConfig.zip atmastercbor
	$(call deploy_to_dev,AnonTokyoConfig.zip)

deploy_program:
# 	构建可执行程序
	@GOOS=windows GOARCH=amd64 CGO_ENABLED=0 go build -o ~/Downloads/AnontokyoServer.exe $(GO_BUILD_FLAGS_DEBUG) .
	$(call deploy_to_dev,AnontokyoServer.exe)
	@cp -f ~/Workdata/anontokyo_server/Makefile ~/Workdata/testgo/resources/Makefile


deploy_window_do_fast:
	@GOOS=windows GOARCH=amd64 CGO_ENABLED=0 go build -o ~/Downloads/AnontokyoServer.exe $(GO_BUILD_FLAGS_DEBUG) .
	$(call deploy_to_dev,AnontokyoServer.exe)

print_version:
	$(call print_version_info)
	@cp -f ~/Workdata/anontokyo_server/Makefile ~/Workdata/testgo/resources/AnontokyoMakefile

update_cover_tool:
	@GOOS=windows GOARCH=amd64 CGO_ENABLED=0 go build -o ~/Downloads/AnontokyoBuildCbor.exe $(GO_BUILD_FLAGS_DEBUG) cmd/convert_master/main.go
	$(call deploy_to_dev,AnontokyoBuildCbor.exe)

redis:
	$(call deploy_to_dev,Redis.zip)

mysql:
