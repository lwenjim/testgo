doc:
	$(call deploy_to_dev,AnontokyoDocs.zip)

# HTTP 运维接口文档: 纯 Go 解析源码(路由 + handler 注解 + 结构体)生成自包含 HTML, 浏览器直接打开, 不依赖 swag。
http_doc:
	@go run cmd/gen_http_doc_native/main.go -dir internal/handler/web -out docs/http_admin.html
	@echo "HTTP 接口文档已生成: docs/http_admin.html"

# ========== 清理 ==========

clean:
	@rm -f *.coverprofile
	@rm -f coverage.*
	@fd --glob  "anontokyo_server.log"|xargs rm -rf
	@echo Clean Finish

# ========== 可复用函数 ==========

# 打印版本信息 (本地 + dev + sirius)
define print_version_info
	@echo 开发版本: $(shell cat atmastercbor/Version; echo)
	@echo 本地版本: $(shell grpcurl -plaintext $(DEVHOST):9090 app.bilibili.anontokyo.MasterdataService.Version | jq -c)
	@echo 测试版本: $(shell grpcurl $(GRPC_ENDPOINT) app.bilibili.anontokyo.MasterdataService.Version | jq -c)
endef

# 重建分片数据库: $(1) = 目标主机
define rebuild_shard_db
	@mysql -uroot -h$(1) -e "show databases" | egrep -e "anontokyo_shard_\d" | xargs -I {} echo "\"mysql -h$(1) -uroot -e 'drop database \"{}\"'\"" | xargs -I {} sh -c {}
	@cat /tmp/load_data.txt | xargs -I {} echo 'mysql -uroot -P3306 -h$(1) <'{} > /tmp/data.txt
	@cat /tmp/data.txt | xargs -I {} bash -c {}
endef

# 部署文件到 dev 服务器: $(1) = 文件名
define deploy_to_dev
	curl http://$(DEVHOST)/deploy\?execName\=$(1)\&version\=$(VERSION)
endef

# ========== PHONY ==========

.PHONY: lint test cover mock pre_commit \
        convert_master proto generate_shard_sql create_database_shard_from_sql generate_gorm_model \
        build run deploy_release \
        deploy_sirius deploy_window deploy_window_do print_version \
        update_model update_cover_tool redis mysql clean xml_to_csv_build_run \
		xml_to_csv_build switch_to_local http_doc \
		convert_master_reverse deploy_table deploy_program