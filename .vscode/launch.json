{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "PowerShell File",
            "type": "PowerShell",
            "request": "launch",
            "script": "${file}",
            "cwd": "${cwd}",
            "createTemporaryIntegratedConsole": false,
            "internalConsoleOptions": "neverOpen",
        },
        {
            "name": "Debug File",
            "type": "php",
            "request": "launch",
            "program": "${file}",
            "cwd": "${fileDirname}",
            "port": 0,
            "runtimeArgs": [
                "-dxdebug.mode =debug",
                "-dxdebug.start_with_request=yes"
            ],
            "env": {
                "XDEBUG_CONFIG": "remote_port=${port}"
            }
        },
        {
            "name": "Launch test function",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}",
            "args": [
                "-test.run",
                "TestGeneralSql"
            ]
        }
    ]
}