{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug DeployService",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/bin/Debug/net8.0-windows/DeployService.dll",
            "args": [
                "service",
                "run"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "DOTNET_ROOT": "d:\\bin"
            },
            "console": "integratedTerminal",
            "stopAtEntry": false,
            "justMyCode": true,
            "logging": {
                "moduleLoad": false,
                "exceptions": true,
                "processExit": false
            }
        },
        {
            "name": ".NET Core Launch (terminal)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/bin/Debug/net8.0-windows/DeployService.dll",
            "args": [
                "service",
                "run"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "DOTNET_ROOT": "d:\\bin"
            },
            "stopAtEntry": false,
            "justMyCode": true,
            "console": "integratedTerminal"
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        }
    ]
}
