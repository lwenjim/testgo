<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Index of {{ base_path }}</title>
<style>
body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, monospace;
    margin: 20px;
    background: #fafafa;
}

h1 {
    font-size: 1.2em;
    color: #333;
    border-bottom: 1px solid #ddd;
    padding-bottom: 8px;
}

.directory {
    width: 100%;
    max-width: 900px;
}

.directory-header {
    display: grid;
    grid-template-columns: 3fr 1fr 1.5fr;
    padding: 8px;
    font-weight: bold;
    border-bottom: 1px dashed #ccc;
    background: #f0f0f0;
}

.directory-row {
    display: grid;
    grid-template-columns: 3fr 1fr 1.5fr;
    padding: 6px 8px;
    border-bottom: 1px dashed #eee;
}

.directory-row:hover {
    background-color: #f5f5f5;
}

.name {
    text-align: left;
}

.name a {
    text-decoration: none;
    color: #0066cc;
}

.name a:hover {
    text-decoration: underline;
}

.size {
    text-align: right;
}

.modified {
    text-align: right;
    color: #666;
}
</style>
</head>
<body>
<h1>Index of {{ base_path }}</h1>
<div class="directory">
    <div class="directory-header">
        <div class="name">文件名</div>
        <div class="size">大小(byte)</div>
        <div class="modified">修改时间</div>
    </div>
{{ for item in items }}
    <div class="directory-row">
        <div class="name"><a href="{{ item.href }}">{{ item.name }}</a></div>
        <div class="size">{{ item.size }}</div>
        <div class="modified">{{ item.modified }}</div>
    </div>
{{ end }}
</div>
</body>
</html>